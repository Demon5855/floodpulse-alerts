# Copiar a .env y llenar.

# API de riesgo (backend FloodPulse)
API_BASE=http://localhost:8000

# Gateway SMS local (celular con Termux)
GATEWAY_URL=http://[TERMUX_IP_ADDRESS]
GATEWAY_TOKEN=[Inserte Contraseña]

# Twilio (opcional, solo si PROVEEDOR = "twilio")
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Cadena de envio: se intenta en orden y se degrada al siguiente si falla.
PROVEEDORES=gateway

# Vonage
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=FloodPulse

# Plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM=
