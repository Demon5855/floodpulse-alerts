# Copiar a .env y llenar.

# API de riesgo (backend FloodPulse)
API_BASE=http://localhost:8000

# Gateway SMS local (celular con Termux)
GATEWAY_URL=http://192.168.1.20:8080
GATEWAY_TOKEN=pon-aqui-una-clave-tuya

# Twilio (respaldo cloud)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# AWS SNS (canal cloud principal)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SENDER_ID=FLOODPULSE

# Cadena de envio: se intenta en orden y se degrada al siguiente si falla.
# Ej: cloud primario con respaldo local -> aws,gateway
PROVEEDORES=gateway

# API de suscriptores (la consume el dashboard)
API_KEY=pon-aqui-una-clave-compartida-con-el-dashboard
PUERTO_SUSCRIPTORES=8100
CORS_ORIGEN=*
